# ─── LINE Messaging API ───────────────────────────────────────────────────────
# Copy this file to .env and fill in YOUR values.
# NEVER commit .env to git.

LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# ─── LINE Login (OAuth 2.0 / OpenID Connect) ─────────────────────────────────
# จากหน้า "LINE Login channel" ใน LINE Developers Console (channel แยกจาก
# Messaging API channel ข้างบน). ใช้สำหรับ 1-click link บนเว็บ — ทดแทนการพิมพ์
# "เชื่อม <email>" ที่ไม่ verify เจ้าของ LINE.
# - LINE_LOGIN_CHANNEL_ID   = ตัวเลข (Channel ID)
# - LINE_LOGIN_CHANNEL_SECRET = แฮชที่อยู่ใต้ Channel ID (ใช้ verify id_token HS256)
# - LINE_LOGIN_CALLBACK_URL = optional, ถ้าไม่ตั้ง derive จาก request host
#   ต้องตรงกับ Callback URL ที่ลงทะเบียนใน LINE Developers Console (ห้ามต่างแม้ "/")
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=

# ─── Flask state-token signing ───────────────────────────────────────────────
# ใช้ sign state JWT (10 นาที TTL) ใน LINE OAuth flow + reuse ได้สำหรับ
# future session cookies. แนะนำ random string ≥32 chars (เช่น `secrets.token_urlsafe(48)`)
FLASK_SECRET_KEY=

# ─── Database (production only) ──────────────────────────────────────────────
# Leave blank to use local SQLite at data/moneymind.db
# Set to a Postgres URL when deploying (Render, Supabase, Neon):
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ─── AI provider ─────────────────────────────────────────────────────────────
# /api/ai/complete รองรับ 2 providers (priority: Gemini ก่อน, Anthropic fallback)
# - Gemini ใช้ฟรีได้ (มี free tier จริง) → แนะนำตั้งตัวนี้
# - Anthropic ต้องจ่ายตาม token → ใช้เป็น fallback หรือสลับกลับมาได้
# ตั้งแค่ตัวเดียวก็พอ; ถ้าตั้งทั้งคู่ Gemini จะถูกลองก่อน, fail แล้วค่อยตก Anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── App settings (optional) ─────────────────────────────────────────────────
# PORT=5000          # auto-set by Render
# FLASK_ENV=development
